<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📈 Добавить доход"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Тип транзакции -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:weightSum="2">

            <Button
                android:id="@+id/incomeTypeButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="📈 Доход"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:layout_marginEnd="4dp"
                android:background="@drawable/button_type_selected"
                android:textColor="@color/white"/>

            <Button
                android:id="@+id/expenseTypeButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="📉 Расход"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:layout_marginStart="4dp"
                android:background="@drawable/button_type_unselected"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

        <!-- Счет -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Счет"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/accountSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/spinner_background_custom"
            android:layout_marginBottom="16dp"/>

        <!-- Категория -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Категория"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/categorySpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/spinner_background_custom"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/newCategoryEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Название новой категории"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:background="@drawable/edit_text_background_custom"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <!-- Сумма + Кнопка сканирования -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сумма"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/amountEditText"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="0.00"
                android:inputType="numberDecimal"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@drawable/edit_text_background_custom"
                android:padding="12dp"
                android:layout_marginEnd="8dp"/>

            <Spinner
                android:id="@+id/currencySpinner"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="80dp"
                android:background="@drawable/spinner_background_custom"/>

            <!-- КНОПКА СКАНИРОВАНИЯ ЧЕКА -->
            <Button
                android:id="@+id/scanReceiptButton"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:text="📷"
                android:textSize="20sp"
                android:gravity="center"
                android:background="@drawable/button_primary"
                android:textColor="@color/white"
                android:layout_marginStart="8dp"
                android:tooltipText="Сканировать чек"/>
        </LinearLayout>

        <!-- Тип средства -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Тип средства"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:weightSum="3">

            <Button
                android:id="@+id/cashButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="💵"
                android:textSize="20sp"
                android:textAllCaps="false"
                android:layout_marginEnd="4dp"
                android:background="@drawable/button_payment_unselected"
                android:textColor="@color/text_primary"
                android:tooltipText="Наличные"/>

            <Button
                android:id="@+id/cardButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="💳"
                android:textSize="20sp"
                android:textAllCaps="false"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/button_payment_card_selected"
                android:textColor="@color/white"
                android:tooltipText="Карта"/>

            <Button
                android:id="@+id/electronicButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="📱"
                android:textSize="20sp"
                android:textAllCaps="false"
                android:layout_marginStart="4dp"
                android:background="@drawable/button_payment_unselected"
                android:textColor="@color/text_primary"
                android:tooltipText="Электронные деньги"/>
        </LinearLayout>

        <!-- Дата -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Дата"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:id="@+id/dateLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/button_date_background"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/dateTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅 Выберите дату"
                android:textSize="14sp"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

        <!-- Описание -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Описание (необязательно)"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/notesEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Краткое описание"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:background="@drawable/edit_text_background_custom"
            android:padding="12dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/operationsInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 У вас 0 доходов на сумму 0.00 руб."
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:gravity="center"
            android:padding="10dp"/>

    </LinearLayout>

</ScrollView>