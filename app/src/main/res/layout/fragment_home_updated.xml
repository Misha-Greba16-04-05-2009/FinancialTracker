<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="@drawable/gradient_background">

    <!-- Отображение баланса -->
    <TextView
        android:id="@+id/balanceTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Баланс: 0 руб.\nДоходы: 0 руб.\nРасходы: 0 руб."
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="30dp"
        android:background="@drawable/rounded_corner"
        android:padding="25dp"
        android:gravity="center"
        android:lineSpacingExtra="5sp"
        android:textColor="@android:color/white"/>

    <!-- Сообщение о превышении расходов -->
    <TextView
        android:id="@+id/warningTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="30dp"
        android:padding="15dp"
        android:visibility="gone"
        android:background="@drawable/warning_background"
        android:textColor="#FF6F00"/>

    <!-- Информация о данных -->
    <TextView
        android:id="@+id/dataSizeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💾 Данные: 0 КБ | 📊 Записей: 0"
        android:textSize="14sp"
        android:textColor="#B3FFFFFF"
        android:layout_marginBottom="40dp"/>

    <!-- Кнопки действий -->
    <Button
        android:id="@+id/addIncomeButton"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:text="➕ Добавить доход"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:background="@drawable/button_gradient_income"
        android:layout_marginBottom="15dp"/>

    <Button
        android:id="@+id/addExpenseButton"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:text="➖ Добавить расход"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:background="@drawable/button_gradient_expense"
        android:layout_marginBottom="30dp"/>

    <!-- Разделитель -->
    <View
        android:layout_width="200dp"
        android:layout_height="1dp"
        android:background="#40FFFFFF"
        android:layout_marginBottom="20dp"/>

    <!-- Кнопки очистки (показываются только если есть данные) -->
    <LinearLayout
        android:id="@+id/clearButtonsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗑️ Очистка данных"
            android:textSize="16sp"
            android:textColor="#B3FFFFFF"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/clearHistoryButton"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:text="Только историю"
            android:textSize="14sp"
            android:background="@drawable/button_clear_history"
            android:textColor="#757575"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/clearAllButton"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:text="ВСЁ полностью"
            android:textSize="14sp"
            android:background="@drawable/button_clear_all"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(включая баланс)"
            android:textSize="11sp"
            android:textColor="#80FF5252"/>

    </LinearLayout>

</LinearLayout>