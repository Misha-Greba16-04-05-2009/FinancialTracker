<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="5dp">

        <!-- Название счета -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Название счета:"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginBottom="5dp"/>

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:background="@drawable/rounded_gray"
            android:hint="Например: Кошелек, Карта Тинькофф, Яндекс.Деньги"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#757575" />

        <!-- Тип счета -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Тип счета:"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Основной: для ежедневных операций\n• Сберегательный: для накоплений\n• Инвестиционный: для инвестиций\n• Кредитный: для кредитов и долгов"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginBottom="10dp"
            android:lineSpacingExtra="4dp"/>

        <Spinner
            android:id="@+id/typeSpinner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/rounded_gray"
            android:popupBackground="#FFFFFF"/>

        <!-- Тип средства -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Тип средства:"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💵 Наличные - физические деньги\n💳 Карта - банковская карта\n📱 Электронные деньги - Яндекс.Деньги, Qiwi и др."
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginBottom="10dp"
            android:lineSpacingExtra="4dp"/>

        <Spinner
            android:id="@+id/paymentTypeSpinner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/rounded_gray"
            android:popupBackground="#FFFFFF"/>

        <!-- Баланс -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Начальный баланс:"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginBottom="5dp"/>

        <EditText
            android:id="@+id/balanceInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:inputType="numberDecimal"
            android:hint="0.00"
            android:padding="12dp"
            android:layout_marginBottom="15dp"
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:background="@drawable/rounded_gray"/>

        <!-- Валюта -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Валюта (опционально):"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginBottom="5dp"/>

        <EditText
            android:id="@+id/currencyInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="руб., $, € и т.д."
            android:padding="12dp"
            android:layout_marginBottom="15dp"
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:background="@drawable/rounded_gray"/>

        <!-- Комментарии -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Комментарии (опционально):"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginBottom="5dp"/>

        <EditText
            android:id="@+id/notesInput"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:inputType="textMultiLine"
            android:hint="Дополнительная информация о счете..."
            android:padding="12dp"
            android:gravity="top"
            android:layout_marginBottom="15dp"
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:background="@drawable/rounded_gray"/>

    </LinearLayout>

</ScrollView>