<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Заголовок -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💸 Новый перевод"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- Счет отправителя -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📤 Со счета"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/fromAccountSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/spinner_background"
            android:padding="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- Счет получателя -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📥 На счет"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/toAccountSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/spinner_background"
            android:padding="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- Кнопка поменять местами -->
        <Button
            android:id="@+id/convertButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Поменять счета местами"
            android:textSize="14sp"
            android:background="@drawable/button_outline"
            android:textColor="#2196F3"
            android:padding="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- Сумма перевода -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💰 Сумма перевода"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/amountEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="0.00"
                android:inputType="numberDecimal"
                android:background="@drawable/spinner_background"
                android:padding="12dp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/fromCurrencyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RUB"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2196F3"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:background="@drawable/currency_badge_background"/>
        </LinearLayout>

        <!-- Информация о конвертации -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/info_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💱 Результат конвертации"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/convertedAmountText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0.00"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#4CAF50"/>

                <TextView
                    android:id="@+id/toCurrencyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RUB"
                    android:textSize="16sp"
                    android:textColor="#2196F3"
                    android:paddingHorizontal="8dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/rateInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Курс: 1 USD = 91.71 RUB"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/warningText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ Разные валюты - будет применена конвертация по текущему курсу"
                android:textSize="11sp"
                android:textColor="#F44336"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Комиссия (опционально) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💸 Комиссия (необязательно)"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/commissionEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0.00"
            android:inputType="numberDecimal"
            android:background="@drawable/spinner_background"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Дата перевода -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 Дата перевода"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:id="@+id/dateLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/button_date_background"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/dateTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅 Выберите дату"
                android:textSize="14sp"
                android:textColor="#333333"/>
        </LinearLayout>

        <!-- Описание (опционально) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 Описание (необязательно)"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/descriptionEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Например: Перевод арендной платы"
            android:inputType="text"
            android:background="@drawable/spinner_background"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Заметки (опционально) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💬 Заметки (необязательно)"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/notesEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Дополнительная информация"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:background="@drawable/spinner_background"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Предупреждение -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ Переводы с конвертацией выполняются по текущему курсу ЦБ РФ"
            android:textSize="11sp"
            android:textColor="#FF9800"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

    </LinearLayout>

</ScrollView>