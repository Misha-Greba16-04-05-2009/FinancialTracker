<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Заголовок -->
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#2196F3"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💱 Конвертер валют"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>

    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Карточка конвертера -->
            <androidx.cardview.widget.CardView
                android:id="@+id/converterCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔄 Конвертер"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginBottom="20dp"/>

                    <!-- Из -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Из валюты"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="4dp"/>

                    <Spinner
                        android:id="@+id/fromCurrencySpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/spinner_background"
                        android:padding="8dp"/>

                    <!-- В -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="В валюту"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="4dp"/>

                    <Spinner
                        android:id="@+id/toCurrencySpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/spinner_background"
                        android:padding="8dp"/>

                    <!-- Кнопка обмена -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="16dp">

                        <ImageButton
                            android:id="@+id/swapButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_swap"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:scaleType="centerInside"
                            android:padding="12dp"/>

                    </LinearLayout>

                    <!-- Сумма -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Сумма"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/amountEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Введите сумму"
                        android:inputType="numberDecimal"
                        android:background="@drawable/spinner_background"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Результат -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Результат"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/resultTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="$ 0.00"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#2196F3"
                        android:gravity="center"
                        android:padding="16dp"
                        android:background="@drawable/result_background"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/rateTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1 USD = 90.00 RUB"
                        android:textSize="12sp"
                        android:textColor="#757575"
                        android:gravity="center"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Карточка избранных валют -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⭐ Избранные валюты"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:id="@+id/favoriteCurrenciesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Нажмите на валюту для быстрой конвертации"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Карточка всех валют -->
            <androidx.cardview.widget.CardView
                android:id="@+id/ratesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="💱 Все валюты"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#333333"/>

                        <Button
                            android:id="@+id/updateRatesButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔄 Обновить"
                            android:textSize="12sp"
                            android:background="@drawable/button_primary"
                            android:textColor="#FFFFFF"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/lastUpdateTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Последнее обновление: никогда"
                        android:textSize="12sp"
                        android:textColor="#757575"
                        android:layout_marginBottom="16dp"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/allCurrenciesRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>