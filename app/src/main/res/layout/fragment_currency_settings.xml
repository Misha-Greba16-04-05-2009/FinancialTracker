<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Карточка общей суммы -->
            <androidx.cardview.widget.CardView
                android:id="@+id/totalBalanceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💰 Общий баланс"
                        android:textSize="16sp"
                        android:textColor="#666666"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/totalBalanceInBaseText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0.00 ₽"
                        android:textSize="32sp"
                        android:textColor="#2196F3"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/baseCurrencyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="RUB"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:gravity="center"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Настройки курсов -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚙️ Настройки курсов"
                        android:textSize="18sp"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Автообновление"
                            android:textSize="16sp"
                            android:textColor="#333333"/>

                        <Switch
                            android:id="@+id/autoUpdateSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/lastUpdateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Последнее обновление: никогда"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="16dp"/>

                    <Button
                        android:id="@+id/updateNowButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔄 Обновить сейчас"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_primary"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Список валют -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💱 Курсы валют"
                        android:textSize="18sp"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <Button
                        android:id="@+id/setBaseCurrencyButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏦 Сменить базовую валюту"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/button_orange"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:id="@+id/currenciesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>