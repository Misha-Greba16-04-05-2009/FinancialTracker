<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💾 Управление данными"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/exportButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📤 Экспорт в файл"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_primary"
        android:padding="12dp"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/importButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📥 Импорт из файла"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_orange"
        android:padding="12dp"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/autoBackupButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔄 Создать автобэкап"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_success"
        android:padding="12dp"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/restoreAutoButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="↩️ Восстановить из автобэкапа"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_info"
        android:padding="12dp"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/historyButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋 История бэкапов"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_info"
        android:padding="12dp"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/lastBackupText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Последний бэкап: никогда"
        android:textSize="12sp"
        android:textColor="#757575"
        android:gravity="center"
        android:layout_marginTop="10dp"/>

</LinearLayout>