<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/reportsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 Отчёты"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp"/>

        <!-- Быстрые отчёты -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_background"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ Быстрые отчёты"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/monthlyReportButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="📅 Месячный отчёт"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/success_color"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/yearlyReportButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="📆 Годовой отчёт"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/primary_color"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/categoryReportButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🏷️ Отчёт по категориям"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/warning_orange"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Экспорт -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_background"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💾 Экспорт данных"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/generatePdfButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="📄 Создать PDF отчёт"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:backgroundTint="#9C27B0"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/exportCsvButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="📊 Экспорт в CSV"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:backgroundTint="#607D8B"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Информация -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ℹ️ Информация"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Отчёты помогут вам:\n• Анализировать финансы\n• Планировать бюджет\n• Отслеживать прогресс\n• Принимать решения"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>