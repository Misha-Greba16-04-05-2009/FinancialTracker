<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Заголовок -->
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#2196F3"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💸 Переводы между счетами"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>

    </androidx.appcompat.widget.Toolbar>

    <!-- Кнопка нового перевода -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <Button
            android:id="@+id/newTransferButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="➕ Новый перевод"
            android:textSize="16sp"
            android:background="@drawable/button_primary"
            android:textColor="#FFFFFF"
            android:padding="12dp"/>
    </LinearLayout>

    <!-- Индикатор загрузки -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="50dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Загрузка переводов..."
            android:textSize="14sp"
            android:textColor="#757575"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

    <!-- Пустое состояние -->
    <TextView
        android:id="@+id/emptyStateText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="📭 Нет переводов\n\nНажмите 'Новый перевод' чтобы создать первый"
        android:textSize="16sp"
        android:textColor="#757575"
        android:gravity="center"
        android:padding="50dp"
        android:visibility="gone"/>

    <!-- Список переводов -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transfersRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:visibility="visible"/>

</LinearLayout>