<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Верхняя строка: код и название -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/currencyCodeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$ USD"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/currencyNameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Доллар США"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginStart="8dp"/>

            <TextView
                android:id="@+id/deviationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0.00%"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"/>

        </LinearLayout>

        <!-- Официальный курс ЦБ -->
        <TextView
            android:id="@+id/officialRateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ЦБ: 77.1880"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginBottom="8dp"/>

        <!-- Редактирование курса -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/rateEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="77.1880"
                android:inputType="numberDecimal"
                android:background="@drawable/spinner_background"
                android:padding="8dp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/resetButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↺"
                android:textSize="16sp"
                android:background="@drawable/button_outline_small"
                android:textColor="#2196F3"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/deleteButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/button_danger_small"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>