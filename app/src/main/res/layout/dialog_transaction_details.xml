<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 Детали транзакции"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- Тип -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Тип:"
                android:textSize="14sp"
                android:textColor="#666666"/>

            <TextView
                android:id="@+id/typeValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Доход"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"/>
        </LinearLayout>

        <!-- Категория -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Категория:"
                android:textSize="14sp"
                android:textColor="#666666"/>

            <TextView
                android:id="@+id/categoryValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📦 Категория"
                android:textSize="16sp"
                android:textColor="#2196F3"/>
        </LinearLayout>

        <!-- Сумма -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Сумма:"
                android:textSize="14sp"
                android:textColor="#666666"/>

            <TextView
                android:id="@+id/amountValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 ₽"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/currencyValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RUB"
                android:textSize="12sp"
                android:textColor="#757575"
                android:background="@drawable/currency_badge_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"/>
        </LinearLayout>

        <!-- Сумма в базовой валюте -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="В базовой:"
                android:textSize="14sp"
                android:textColor="#666666"/>

            <TextView
                android:id="@+id/amountInBaseValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.00 ₽"
                android:textSize="14sp"
                android:textColor="#757575"/>
        </LinearLayout>

        <!-- Дата -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Дата:"
                android:textSize="14sp"
                android:textColor="#666666"/>

            <TextView
                android:id="@+id/dateValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="01.01.2024"
                android:textSize="16sp"
                android:textColor="#333333"/>
        </LinearLayout>

        <!-- Счет -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Счет:"
                android:textSize="14sp"
                android:textColor="#666666"/>

            <TextView
                android:id="@+id/accountValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Основная карта"
                android:textSize="16sp"
                android:textColor="#333333"/>
        </LinearLayout>

        <!-- Тип платежа -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Тип платежа:"
                android:textSize="14sp"
                android:textColor="#666666"/>

            <TextView
                android:id="@+id/paymentTypeValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💳 Карта"
                android:textSize="16sp"
                android:textColor="#3F51B5"/>
        </LinearLayout>

        <!-- Описание -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Описание:"
                android:textSize="14sp"
                android:textColor="#666666"/>

            <TextView
                android:id="@+id/descriptionValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Описание транзакции"
                android:textSize="16sp"
                android:textColor="#333333"/>
        </LinearLayout>

        <!-- Заметки -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Заметки:"
                android:textSize="14sp"
                android:textColor="#666666"/>

            <TextView
                android:id="@+id/notesValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Нет заметок"
                android:textSize="14sp"
                android:textColor="#757575"
                android:paddingVertical="4dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginVertical="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ID транзакции:"
            android:textSize="10sp"
            android:textColor="#999999"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/transactionIdValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="..."
            android:textSize="8sp"
            android:textColor="#999999"/>

    </LinearLayout>

</ScrollView>