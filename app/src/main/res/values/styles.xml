<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Theme.FinancialTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary_color</item>
        <item name="colorSecondaryVariant">@color/secondary_color</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>

        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:navigationBarColor">@color/surface_color</item>

        <!-- Material Components -->
        <item name="materialButtonStyle">@style/Widget.AppCompat.Button</item>

        <!-- Удалите эту строку -->
        <!-- <item name="cardViewStyle">@android:style/Widget.CardView</item> -->

        <!-- Typography -->
        <item name="android:textAppearanceLarge">@android:style/TextAppearance.Large</item>
        <item name="android:textAppearanceMedium">@android:style/TextAppearance.Medium</item>
        <item name="android:textAppearanceSmall">@android:style/TextAppearance.Small</item>
    </style>

    <!-- Упрощенные стили для совместимости -->
    <style name="Widget.FinancialTracker.Button" parent="Widget.AppCompat.Button">
        <item name="android:padding">16dp</item>
        <item name="android:backgroundTint">@color/primary_color</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Стиль для CardView -->
    <style name="CardViewStyle" parent="CardView">
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>

    <!-- Стили для прогресс-баров -->
    <style name="Widget.FinancialTracker.ProgressBar" parent="Widget.AppCompat.ProgressBar">
        <item name="android:indeterminateTint">@color/primary_color</item>
    </style>

    <style name="Widget.FinancialTracker.ProgressBar.Horizontal" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_horizontal</item>
        <item name="android:minHeight">12dp</item>
    </style>

    <!-- Стиль для кнопки с обводкой -->
    <style name="Widget.FinancialTracker.Button.Outline" parent="Widget.AppCompat.Button">
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/button_outline_background</item>
        <item name="android:textColor">@color/primary_color</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>