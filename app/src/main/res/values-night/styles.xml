<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Стиль для кнопок диалога -->
    <style name="DialogButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/primary_color</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="DialogButtonNegativeStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Стиль для диалогов с белым текстом -->
    <style name="CustomAlertDialogStyle" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:background">@color/dialog_background</item>
        <item name="colorAccent">@color/primary_color</item>
        <item name="android:editTextStyle">@style/CustomEditTextStyle</item>
        <item name="android:spinnerStyle">@style/CustomSpinnerStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonNegativeStyle</item>
    </style>

    <!-- Стиль для EditText -->
    <style name="CustomEditTextStyle" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textColorHighlight">@color/primary_light</item>
        <item name="android:background">@drawable/edit_text_background_custom</item>
        <item name="android:padding">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Стиль для Spinner -->
    <style name="CustomSpinnerStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/spinner_background_custom</item>
        <item name="android:padding">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Стиль для TextView -->
    <style name="CustomTextViewStyle" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Стиль для кнопки с обводкой (тёмная тема) -->
    <style name="Widget.FinancialTracker.Button.Outline" parent="Widget.AppCompat.Button">
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/button_outline_background</item>
        <item name="android:textColor">@color/primary_color</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
